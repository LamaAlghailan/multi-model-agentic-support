# Demo is explicit. Production remains blocked until real model gates pass.
AGENT_MODE=demo
AGENT_API_KEY=replace-with-a-long-random-local-key
WEBUI_SECRET_KEY=replace-with-a-long-random-webui-secret
# For production: mount all three evaluated model directories and regenerate
# release.json inside the deployment environment before starting production.
MODEL_A_PATH=/app/models/intent_classifier
MODEL_B_PATH=/app/models/qa_model
MODEL_C_ADAPTER=/app/models/support_adapter
RELEASE_FILE=/app/reports/release.json
SUPPORT_DB=/app/runtime/support.db
HF_HOME=/app/cache/huggingface
HF_TOKEN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Pin a tested image tag or digest for production. main is for initial local demo only.
OPEN_WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main
